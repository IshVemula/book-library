# Postgres connection string (Neon). Leave unset locally to use the embedded PGlite database.
DATABASE_URL=

# Password for the single admin account that can add/edit/delete books.
ADMIN_PASSWORD=

# Long random string used to sign the login cookie, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# Optional, local only: where the embedded database is stored (default ./.pglite).
PGLITE_PATH=
