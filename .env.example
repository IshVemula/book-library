# Password for the owner account that can add/edit/delete books. Required.
ADMIN_PASSWORD=

# Postgres connection string. Set automatically when you add Neon on Vercel.
# Leave unset locally to use the embedded PGlite database.
DATABASE_URL=

# Optional: random string for signing the login cookie (`openssl rand -base64 32`).
# If unset, one is derived from ADMIN_PASSWORD and DATABASE_URL.
SESSION_SECRET=

# Optional, local only: where the embedded database is stored (default ./.pglite).
PGLITE_PATH=
